# Public browser-side values from Supabase > Project Settings > API.
# Do not put Google Client Secret or Supabase service_role keys here!
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Optional: only set / for a custom domain at the root.
# VITE_BASE_PATH=/
